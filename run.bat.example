@echo off
cd /d "%~dp0"
title Movie Bot

REM ============================================================
REM   FILL IN YOUR VALUES BELOW (replace the <<<...>>> parts)
REM   Then rename this file to run.bat and double-click it.
REM ============================================================
set BOT_TOKEN=<<<PASTE BOT TOKEN FROM @BotFather>>>
set API_ID=<<<e.g. 1234567>>>
set API_HASH=<<<PASTE API HASH from my.telegram.org>>>
set ADMINS=<<<YOUR NUMERIC TELEGRAM ID>>>
set DATABASE_URI=<<<mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true^&w=majority>>>
set DATABASE_NAME=moviebot
set LOG_CHANNEL=<<<e.g. -1001234567890 (bot must be admin here)>>>
set PORT=8080

REM ---- new features ----
set AUTO_FETCH=True
set AUTO_CONVERT=True
set MAX_FETCH_SIZE_MB=2048
set MAX_CONCURRENT_FETCH=1

REM optional (remove REM to use):
REM set CHANNELS=-100111222333
REM set AUTH_CHANNEL=-100111222333

REM ============================================================
REM   You should NOT need to edit below this line
REM ============================================================

if not exist venv\Scripts\activate.bat (
    echo [setup] Creating virtual environment...
    python -m venv venv
)

call venv\Scripts\activate.bat

if not exist venv\.deps_installed (
    echo [setup] Installing dependencies (first run only, takes a few minutes)...
    python -m pip install --upgrade pip
    pip install pyrogram "pymongo[srv]==3.12.3" "motor==2.5.1" "marshmallow==3.14.1" "umongo==3.0.1" requests bs4 shortzy pytz aiohttp PyLeaves "opencv-python-headless>=4.8.1.78" python-dotenv speedtest humanize "Pillow>=10.0.0" "psutil>=5.9.6" "numpy>=1.26.0" wheel ujson wget aiofiles "dnspython==2.3.0" python-decouple "ffmpeg-python>=0.2.0" jinja2 apscheduler pyshorteners pyromod colorama
    if errorlevel 1 goto :err
    pip install "git+https://github.com/Joelkb/cinemagoer"
    if errorlevel 1 goto :err
    echo done > venv\.deps_installed
)

echo [check] Tools (optional):
where ffmpeg  >nul 2>&1 && echo   ffmpeg:  FOUND || echo   ffmpeg:  not found (video convert off)
where aria2c  >nul 2>&1 && echo   aria2c:  FOUND || echo   aria2c:  not found (web-fetch off)

echo [run] Starting bot... (close this window to stop)
python bot.py
goto :end

:err
echo.
echo ==========================================================
echo  DEPENDENCY INSTALL FAILED - copy the red text above here
echo ==========================================================
:end
pause
