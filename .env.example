# ============================================================
#  Movie bot configuration.  Copy this file to  ".env"
#  (same folder as bot.py) and fill in real values.
#  In .env you paste values NORMALLY - do NOT escape & as ^&
#  and do NOT wrap values in quotes.
# ============================================================

BOT_TOKEN=123456:ABC-your-token-from-BotFather
API_ID=1234567
API_HASH=your_api_hash_from_my_telegram_org
ADMINS=767250672

# MongoDB Atlas connection string (paste exactly; keep the normal &)
DATABASE_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=moviebot

# A private channel where the bot is an ADMIN. id starts with -100
LOG_CHANNEL=-1001234567890

# Web server port
PORT=8080

# ---- new features ----
AUTO_FETCH=True
AUTO_CONVERT=True
MAX_FETCH_SIZE_MB=2048
MAX_CONCURRENT_FETCH=1

# ---- optional (add if you use these) ----
# CHANNELS=-100111222333
# AUTH_CHANNEL=-100111222333
# REQST_CHANNEL_ID=-100111222333
# SUPPORT_CHAT_ID=-100111222333
